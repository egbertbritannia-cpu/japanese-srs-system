# Biến môi trường cho Japanese SRS System (Triển khai Ngày 1 & Ngày 2)

# 1. Cơ sở dữ liệu Cloud Turso (LibSQL)
TURSO_DATABASE_URL=libsql://japanese-srs-db-<your-db>.turso.io
TURSO_AUTH_TOKEN=ey...<your-turso-token>

# 2. Khóa API cho AI Copilot Agent (Hỗ trợ OpenAI / Anthropic / Gemini)
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...

# 3. Cấu hình mô hình LLM (Mặc định: gpt-4o-mini hoặc gpt-4o)
LLM_MODEL=gpt-4o-mini
