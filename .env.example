# ==============================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN JAPANESE SRS SYSTEM (FSRS + GOOGLE WORKSPACE)
# ==============================================================================

# 1. Cơ sở dữ liệu Cloud Turso (LibSQL / SQLite Cloud)
# Lấy từ: https://turso.tech -> Database -> Overview
TURSO_DATABASE_URL=libsql://japanese-srs-db-<your-db>.turso.io
TURSO_AUTH_TOKEN=eyJ...<your-turso-jwt-token>

# 2. Tiện ích Google Workspace (Google Sheets, Google Calendar, Google Tasks)
# Tạo miễn phí tại: https://console.cloud.google.com -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
# Chạy local dùng: http://localhost:3000/api/google/callback
# Chạy trên Vercel dùng: https://<domain-vercel-cua-ban>.vercel.app/api/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# 3. Trí tuệ nhân tạo AI Copilot (Tùy chọn - Dùng khi kích hoạt sinh câu ví dụ i+1)
# Lấy API Key miễn phí tại: https://aistudio.google.com
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro
LLM_API_KEY=AIzaSy...your-gemini-api-key
